---
import BaseLayout from './BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

interface Props {
  title: string;
  eyebrow: string;
  description?: string;
  noindex?: boolean;
}

const { title, eyebrow, description, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <div class="page-head">
    <div class="container">
      <SectionHeading eyebrow={eyebrow} title={title} level="h1" />
      <slot name="intro" />
    </div>
  </div>
  <div class="container page-body">
    <slot />
  </div>
</BaseLayout>

<style>
  .page-head {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
    background: var(--c-grey-light);
    border-bottom: 1px solid var(--c-border);
  }
  .page-body {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
</style>
