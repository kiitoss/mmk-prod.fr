---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getImage } from 'astro:assets';
import ProjectVideo from '../components/ProjectVideo.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
import { getProjets } from '../lib/projets';
import showreelPoster from '../assets/projets/rencontres-cinema-beaurepaire-2025.jpg';

const projets = await getProjets();
const showreelPosterImage = await getImage({ src: showreelPoster, format: 'webp', width: 1600 });

const prestations = [
  {
    titre: 'Aftermovie',
    texte:
      "Un film court et rythmé qui fait revivre l'ambiance de votre événement, pensé pour vos réseaux sociaux, votre site et vos prochaines communications.",
    icone: 'film',
  },
  {
    titre: "Captation d'événement",
    texte:
      'Enregistrement de conférences, tables rondes, spectacles ou cérémonies, en une ou plusieurs caméras, avec une prise de son soignée.',
    icone: 'camera',
  },
  {
    titre: 'Formats courts',
    texte:
      'Reels et vidéos verticales pour Instagram, TikTok ou LinkedIn : teasers, coulisses et temps forts, montés pour être partagés.',
    icone: 'reel',
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <video class="hero__bg" autoplay muted loop playsinline preload="auto" poster={showreelPosterImage.src} aria-hidden="true">
      <source src={site.showreel.loop} type="video/mp4" />
    </video>
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">{site.legalName}</p>
        <h1 id="hero-title">Captation vidéo et aftermovies pour vos événements</h1>
        <p class="hero__lead">
          Nous réalisons des aftermovies, des captations et des formats courts pour les entreprises, les associations et les
          organisateurs d'événements.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#contact">Demander un devis</a>
          <a class="btn btn--outline-light" href={site.showreel.video} data-film-open>
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24"><path d="M6 4v16l14-8z" fill="currentColor"></path></svg>
            Voir l'aftermovie
          </a>
        </div>
      </div>
    </div>
  </section>

  <dialog class="film on-dark" aria-label={site.showreel.title} closedby="any">
    <button type="button" class="film__close" data-film-close>
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 5l14 14M19 5L5 19"></path></svg>
      <span class="visually-hidden">Fermer la vidéo</span>
    </button>
    <video controls playsinline preload="none" poster={showreelPosterImage.src}>
      <source src={site.showreel.video} type="video/mp4" />
    </video>
  </dialog>

  <!-- La société -->
  <section id="societe" class="section" aria-labelledby="societe-title">
    <div class="container split">
      <SectionHeading eyebrow="La société" title="Qui sommes-nous ?" id="societe-title" />
      <div class="split__body">
        <p>
          {site.name} est basée à {site.base.city}, dans la vallée du Rhône, à mi-chemin entre Lyon, Saint-Étienne et l'Ardèche. Nous filmons les événements des
          collectivités, des festivals, des entreprises et des artistes à Lyon, Saint-Étienne, en Ardèche et dans toute la
          région, du premier échange jusqu'à la livraison des fichiers.
        </p>
      </div>
    </div>
  </section>

  <!-- Prestations -->
  <section id="prestations" class="section section--alt" aria-labelledby="prestations-title">
    <div class="container">
      <SectionHeading eyebrow="Prestations" title="Ce que nous proposons" id="prestations-title" />
      <ul class="services">
        {
          prestations.map((p) => (
            <li class="service">
              <svg class="service__icon" aria-hidden="true" width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
                {p.icone === 'film' && (
                  <>
                    <rect x="5" y="9" width="30" height="22" rx="1" />
                    <path d="M5 15h30M5 25h30M11 9v6M17 9v6M23 9v6M29 9v6M11 25v6M17 25v6M23 25v6M29 25v6" />
                    <path d="M17.5 17.5v5l4.5-2.5z" />
                  </>
                )}
                {p.icone === 'camera' && (
                  <>
                    <rect x="4" y="12" width="22" height="16" rx="1" />
                    <path d="M26 17.5l10-5v15l-10-5" />
                    <circle cx="10" cy="8" r="3" />
                    <circle cx="19" cy="8" r="3" />
                  </>
                )}
                {p.icone === 'reel' && (
                  <>
                    <rect x="12" y="4" width="16" height="32" rx="2.5" />
                    <path d="M18 32h4" />
                    <path d="M18 15.5v7l6-3.5z" />
                  </>
                )}
              </svg>
              <h3>{p.titre}</h3>
              <p>{p.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Réalisations -->
  <section id="realisations" class="section" aria-labelledby="realisations-title">
    <div class="container">
      <SectionHeading eyebrow="Réalisations" title="Nos derniers projets" id="realisations-title" />
      <div class="works">
        {projets.map((projet) => <ProjectVideo projet={projet} />)}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section section--alt" aria-labelledby="contact-title">
    <div class="container contact">
      <div>
        <SectionHeading eyebrow="Contact" title="Demander un devis" id="contact-title" />
        <p class="contact__intro">
          Décrivez-nous votre événement : nous revenons vers vous avec une proposition adaptée à
          votre besoin et à votre budget.
        </p>
        <dl class="contact__details">
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Zone d'intervention</dt>
            <dd>{site.area}</dd>
          </div>
        </dl>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero : vidéo muette en fond sur tout le bandeau */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(88vh, 820px);
    overflow: hidden;
    background: var(--c-hero);
    color: var(--c-on-dark);
    isolation: isolate;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Voile sombre pour la lisibilité du texte */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.8), rgb(0 0 0 / 0.25) 60%, rgb(0 0 0 / 0.35)),
      linear-gradient(to right, rgb(0 0 0 / 0.55), transparent 70%);
  }
  .hero__inner {
    width: 100%;
    padding-block: clamp(4rem, 10vw, 7rem) clamp(3rem, 7vw, 5rem);
  }
  .hero__text {
    max-width: 44rem;
  }
  .hero__actions .btn {
    gap: 0.5rem;
  }

  /* Film complet, ouvert au clic */
  .film {
    width: min(92vw, 1200px);
    max-width: none;
    padding: 0;
    overflow: visible;
    background: transparent;
    border: 0;
  }
  .film::backdrop {
    background: rgb(0 0 0 / 0.88);
  }
  .film video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--c-black);
    border-radius: var(--radius);
  }
  .film__close {
    position: absolute;
    top: -3rem;
    right: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--c-white);
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .hero__eyebrow {
    margin-bottom: 0.9rem;
    color: var(--c-yellow);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero h1 {
    margin-bottom: 1.25rem;
  }
  .hero__lead {
    max-width: 34rem;
    margin-bottom: 2rem;
    color: var(--c-on-dark-2);
    font-size: var(--fs-lead);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Société */
  .split {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }
  .split__body {
    color: var(--c-text-2);
    font-size: var(--fs-lead);
  }

  /* Prestations */
  .services {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .service {
    padding: 2rem 1.75rem;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-top: 4px solid var(--c-black);
    border-radius: var(--radius);
  }
  .service__icon {
    margin-bottom: 1.25rem;
  }
  .service p {
    margin: 0;
    color: var(--c-text-2);
  }

  /* Réalisations */
  .works {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3rem clamp(1.25rem, 2.5vw, 2rem);
    margin-top: 2.5rem;
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
  }
  .contact__intro {
    margin-top: 1.5rem;
    color: var(--c-text-2);
  }
  .contact__details {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }
  .contact__details dt {
    color: var(--c-text-3);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .contact__details dd {
    margin: 0.1rem 0 0;
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .split,
    .contact {
      grid-template-columns: 1fr;
    }
    .works,
    .services {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    /* Boutons empilés : même mise en page avant et après chargement des polices (pas de CLS) */
    .hero__actions {
      flex-direction: column;
    }
    .works,
    .services {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Film complet : s'ouvre dans une fenêtre et démarre avec le son (le clic autorise la lecture sonore).
  // Sans JavaScript, le bouton ouvre directement le fichier vidéo.
  const film = document.querySelector<HTMLDialogElement>('dialog.film');
  const filmVideo = film?.querySelector('video');
  document.querySelector('[data-film-open]')?.addEventListener('click', (event) => {
    if (!film || !filmVideo) return;
    event.preventDefault();
    film.showModal();
    filmVideo.play().catch(() => {});
  });
  film?.querySelector('[data-film-close]')?.addEventListener('click', () => film.close());
  film?.addEventListener('close', () => filmVideo?.pause());

  // Mouvement réduit demandé par le système : la boucle de fond reste sur l'image fixe
  const heroLoop = document.querySelector<HTMLVideoElement>('.hero__bg');
  if (heroLoop && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    heroLoop.removeAttribute('autoplay');
    heroLoop.pause();
  }
</script>
