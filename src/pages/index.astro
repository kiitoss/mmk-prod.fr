---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import VideoFacade from '../components/VideoFacade.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TeamCard from '../components/TeamCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, formattedAddress } from '../config/site';
import { getProjets } from '../lib/projets';
import showreelPoster from '../assets/showreel-apercu.jpg';
import photoPresident from '../assets/equipe/associe-president.jpg';
import photoDg from '../assets/equipe/associe-dg.jpg';

const derniersProjets = (await getProjets()).slice(0, 3);

const prestations = [
  {
    titre: 'Aftermovie',
    texte:
      "Un film court et rythmé qui fait revivre l'ambiance de votre événement, pensé pour vos réseaux sociaux, votre site et vos prochaines communications.",
    icone: 'film',
  },
  {
    titre: "Captation d'événement",
    texte:
      'Enregistrement de conférences, tables rondes, spectacles ou cérémonies, en une ou plusieurs caméras, avec une prise de son soignée.',
    icone: 'camera',
  },
  {
    titre: 'Reportage photo',
    texte:
      'Des photos naturelles et retouchées des temps forts, des intervenants et des participants, livrées rapidement dans une galerie en ligne.',
    icone: 'photo',
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero on-dark" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__text">
        <p class="hero__eyebrow">{site.legalName}</p>
        <h1 id="hero-title">Captation vidéo et photographie pour vos événements</h1>
        <p class="hero__lead">
          Nous réalisons des aftermovies, des captations et des reportages photo pour les entreprises, les associations et les
          organisateurs d'événements.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#contact">Demander un devis</a>
          <a class="btn btn--outline-light" href="#realisations">Nos réalisations</a>
        </div>
      </div>
      <div class="hero__video">
        <VideoFacade
          provider={site.showreel.provider}
          id={site.showreel.id}
          title={site.showreel.title}
          poster={showreelPoster}
          priority
        />
      </div>
    </div>
  </section>

  <!-- La société -->
  <section id="societe" class="section" aria-labelledby="societe-title">
    <div class="container split">
      <SectionHeading eyebrow="La société" title="Qui sommes-nous ?" id="societe-title" />
      <div class="split__body">
        <p>
          {site.legalName} ({site.meaning}) est une société de production audiovisuelle installée à Lyon. Nous accompagnons
          les entreprises, les associations et les organisateurs d'événements dans toute la région Auvergne-Rhône-Alpes,
          du premier échange jusqu'à la livraison des fichiers.
        </p>
        <p>
          [Présentation à compléter : votre histoire, votre approche, votre matériel, les types d'événements que vous
          couvrez et ce qui vous distingue.]
        </p>
      </div>
    </div>
  </section>

  <!-- Prestations -->
  <section id="prestations" class="section section--alt" aria-labelledby="prestations-title">
    <div class="container">
      <SectionHeading eyebrow="Prestations" title="Ce que nous proposons" id="prestations-title" />
      <ul class="services">
        {
          prestations.map((p) => (
            <li class="service">
              <svg class="service__icon" aria-hidden="true" width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round">
                {p.icone === 'film' && (
                  <>
                    <rect x="5" y="9" width="30" height="22" rx="1" />
                    <path d="M5 15h30M5 25h30M11 9v6M17 9v6M23 9v6M29 9v6M11 25v6M17 25v6M23 25v6M29 25v6" />
                    <path d="M17.5 17.5v5l4.5-2.5z" />
                  </>
                )}
                {p.icone === 'camera' && (
                  <>
                    <rect x="4" y="12" width="22" height="16" rx="1" />
                    <path d="M26 17.5l10-5v15l-10-5" />
                    <circle cx="10" cy="8" r="3" />
                    <circle cx="19" cy="8" r="3" />
                  </>
                )}
                {p.icone === 'photo' && (
                  <>
                    <path d="M5 13h7l3-4h10l3 4h7v18H5z" />
                    <circle cx="20" cy="21" r="6" />
                    <path d="M30 17h1" />
                  </>
                )}
              </svg>
              <h3>{p.titre}</h3>
              <p>{p.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Réalisations -->
  <section id="realisations" class="section" aria-labelledby="realisations-title">
    <div class="container">
      <SectionHeading eyebrow="Réalisations" title="Nos derniers projets" id="realisations-title" />
      <ul class="projects">
        {
          derniersProjets.map((projet) => (
            <li>
              <ProjectCard projet={projet} />
            </li>
          ))
        }
      </ul>
      <p class="projects__more">
        <a class="btn btn--outline" href="/realisations">Voir toutes les réalisations</a>
      </p>
    </div>
  </section>

  <!-- Équipe -->
  <section id="equipe" class="section section--alt" aria-labelledby="equipe-title">
    <div class="container">
      <SectionHeading eyebrow="Équipe" title="Les associés" id="equipe-title" />
      <div class="team">
        <TeamCard name="[Prénom Nom]" role="Président" photo={photoPresident}>
          <p>[Biographie : parcours, spécialités (réalisation, montage, prise de vue…) et rôle au sein de la société.]</p>
        </TeamCard>
        <TeamCard name="Antoine Chataignier" role="Directeur général" photo={photoDg}>
          <p>[Biographie : parcours, spécialités (photographie, production, relation client…) et rôle au sein de la société.]</p>
        </TeamCard>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section" aria-labelledby="contact-title">
    <div class="container contact">
      <div>
        <SectionHeading eyebrow="Contact" title="Demander un devis" id="contact-title" />
        <p class="contact__intro">
          Décrivez-nous votre événement : nous revenons vers vous sous 48 heures ouvrées avec une proposition adaptée à
          votre besoin et à votre budget.
        </p>
        <dl class="contact__details">
          <div>
            <dt>E-mail</dt>
            <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
          </div>
          <div>
            <dt>Téléphone</dt>
            <dd><a href={`tel:${site.phoneHref}`}>{site.phone}</a></dd>
          </div>
          <div>
            <dt>Adresse</dt>
            <dd>{formattedAddress}</dd>
          </div>
          <div>
            <dt>Zone d'intervention</dt>
            <dd>{site.area}</dd>
          </div>
        </dl>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    background: var(--c-hero);
    color: var(--c-on-dark);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }
  .hero__eyebrow {
    margin-bottom: 0.9rem;
    color: var(--c-yellow);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .hero h1 {
    margin-bottom: 1.25rem;
  }
  .hero__lead {
    max-width: 34rem;
    margin-bottom: 2rem;
    color: var(--c-on-dark-2);
    font-size: var(--fs-lead);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Société */
  .split {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }
  .split__body {
    color: var(--c-text-2);
    font-size: var(--fs-lead);
  }

  /* Prestations */
  .services,
  .projects {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .service {
    padding: 2rem 1.75rem;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-top: 4px solid var(--c-black);
    border-radius: var(--radius);
  }
  .service__icon {
    margin-bottom: 1.25rem;
  }
  .service p {
    margin: 0;
    color: var(--c-text-2);
  }

  /* Réalisations */
  .projects__more {
    margin: 2.5rem 0 0;
    text-align: center;
  }

  /* Équipe */
  .team {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  /* Contact */
  .contact {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
  }
  .contact__intro {
    margin-top: 1.5rem;
    color: var(--c-text-2);
  }
  .contact__details {
    display: grid;
    gap: 1rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-border);
  }
  .contact__details dt {
    color: var(--c-text-3);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .contact__details dd {
    margin: 0.1rem 0 0;
    font-weight: 600;
  }

  @media (max-width: 960px) {
    .hero__grid,
    .split,
    .contact {
      grid-template-columns: 1fr;
    }
    .services,
    .projects {
      grid-template-columns: 1fr 1fr;
    }
    .team {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    /* Boutons empilés : même mise en page avant et après chargement des polices (pas de CLS) */
    .hero__actions {
      flex-direction: column;
    }
    .services,
    .projects {
      grid-template-columns: 1fr;
    }
  }
</style>
