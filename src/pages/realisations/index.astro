---
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjets } from '../../lib/projets';

const projets = await getProjets();
---

<PageLayout
  title="Nos réalisations"
  eyebrow="Réalisations"
  description="Aftermovies, captations vidéo et reportages photo réalisés par MMK Production pour des événements à Lyon et en Auvergne-Rhône-Alpes."
>
  <p slot="intro" class="intro">
    Une sélection d'événements que nous avons filmés et photographiés pour des entreprises, des associations et des
    organisateurs.
  </p>
  <ul class="projects">
    {
      projets.map((projet) => (
        <li>
          <ProjectCard projet={projet} headingLevel="h2" />
        </li>
      ))
    }
  </ul>
</PageLayout>

<style>
  .intro {
    max-width: 60ch;
    margin: 1.5rem 0 0;
    color: var(--c-text-2);
    font-size: var(--fs-lead);
  }
  .projects {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
