---
import type { GetStaticPaths } from 'astro';
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VideoFacade from '../../components/VideoFacade.astro';
import Gallery from '../../components/Gallery.astro';
import { getProjets, typeLabels, formatDate, type Projet } from '../../lib/projets';

export const getStaticPaths = (async () => {
  const projets = await getProjets();
  return projets.map((projet) => ({ params: { slug: projet.id }, props: { projet } }));
}) satisfies GetStaticPaths;

interface Props {
  projet: Projet;
}

const { projet } = Astro.props;
const { titre, client, lieu, date, type, vignette, vignetteAlt, videoId, provider, galerie } = projet.data;
const { Content } = await render(projet);
const description = `${typeLabels[type]} réalisé par MMK Production pour ${client} — ${lieu}, ${formatDate(date)}.`;
---

<BaseLayout title={titre} description={description} type="article">
  <article>
    <header class="head">
      <div class="container">
        <nav aria-label="Fil d'Ariane" class="crumbs">
          <ol>
            <li><a href="/">Accueil</a></li>
            <li><a href="/realisations">Réalisations</a></li>
            <li aria-current="page">{titre}</li>
          </ol>
        </nav>
        <p class="eyebrow">{typeLabels[type]} · {date.getUTCFullYear()}</p>
        <h1>{titre}</h1>
        <span class="rule" aria-hidden="true"></span>
      </div>
    </header>

    <div class="container body">
      <div class="media">
        {
          videoId ? (
            <VideoFacade
              provider={provider}
              id={videoId}
              title={titre}
              poster={vignette}
              posterAlt={vignetteAlt}
              priority
              sizes="(min-width: 1180px) 760px, (min-width: 900px) 65vw, 100vw"
            />
          ) : (
            <Picture
              src={vignette}
              alt={vignetteAlt ?? ''}
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 1180px) 760px, (min-width: 900px) 65vw, 100vw"
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              loading="eager"
              fetchpriority="high"
              class="cover"
            />
          )
        }
      </div>

      <aside class="facts" aria-label="Informations sur le projet">
        <dl>
          <div><dt>Client</dt><dd>{client}</dd></div>
          <div><dt>Lieu</dt><dd>{lieu}</dd></div>
          <div><dt>Date</dt><dd><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></dd></div>
          <div><dt>Prestation</dt><dd>{typeLabels[type]}</dd></div>
        </dl>
        <a class="btn btn--primary" href="/#contact">Demander un devis</a>
      </aside>

      <div class="prose content">
        <Content />
      </div>
    </div>

    {
      galerie && galerie.length > 0 && (
        <section class="section section--alt" aria-labelledby="galerie-title">
          <div class="container">
            <h2 id="galerie-title">Galerie photo</h2>
            <Gallery images={galerie} label={titre} />
          </div>
        </section>
      )
    }

    <div class="container back">
      <a class="link-arrow" href="/realisations">← Toutes les réalisations</a>
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(2rem, 5vw, 3.5rem);
    background: var(--c-grey-light);
    border-bottom: 1px solid var(--c-border);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
    color: var(--c-text-3);
    font-size: var(--fs-sm);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.35rem;
  }
  .eyebrow {
    margin-bottom: 0.5rem;
    color: var(--c-text-3);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  h1 {
    margin-bottom: 1.25rem;
  }
  .rule {
    display: block;
    width: 56px;
    height: 4px;
    background: var(--c-yellow);
  }
  .body {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .media :global(.cover) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .facts {
    align-self: start;
    padding: 1.5rem;
    border: 1px solid var(--c-border);
    border-top: 4px solid var(--c-black);
    border-radius: var(--radius);
  }
  .facts dl {
    display: grid;
    gap: 1rem;
    margin: 0 0 1.5rem;
  }
  .facts dt {
    color: var(--c-text-3);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .facts dd {
    margin: 0.1rem 0 0;
    font-weight: 600;
  }
  .facts .btn {
    width: 100%;
  }
  .content {
    grid-column: 1;
  }
  .back {
    padding-block: 2.5rem 4rem;
  }
  @media (max-width: 900px) {
    .body {
      grid-template-columns: 1fr;
    }
  }
</style>
