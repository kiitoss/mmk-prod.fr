---
import { site, nav, formattedAddress } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="footer on-dark">
  <div class="container footer__grid">
    <div>
      <p class="footer__name">{site.name}</p>
      <p>
        {site.legal.form} au capital de {site.legal.capital}<br />
        {site.legal.rcs} · SIRET {site.legal.siret}<br />
        {formattedAddress}
      </p>
    </div>

    <nav aria-labelledby="footer-nav">
      <h2 id="footer-nav" class="footer__title">Navigation</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/realisations">Toutes les réalisations</a></li>
        <li><a href="/#contact">Contact</a></li>
      </ul>
    </nav>

    <nav aria-labelledby="footer-info">
      <h2 id="footer-info" class="footer__title">Informations</h2>
      <ul>
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/confidentialite">Politique de confidentialité</a></li>
        <li><a href={site.social.instagram} rel="me noopener">Instagram</a></li>
      </ul>
    </nav>
  </div>

  <div class="footer__bottom">
    <div class="container">
      <p>© {year} {site.legalName}. Tous droits réservés.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--c-black);
    color: var(--c-on-dark-2);
    font-size: 0.9375rem;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: 3.5rem;
  }
  .footer__name {
    margin-bottom: 0.75rem;
    color: var(--c-white);
    font-family: var(--ff-serif);
    font-size: 1.375rem;
    font-weight: 700;
  }
  .footer__title {
    margin-bottom: 1rem;
    color: var(--c-white);
    font-family: var(--ff-sans);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li + li {
    margin-top: 0.5rem;
  }
  a {
    color: var(--c-on-dark-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--c-white);
    text-decoration: underline;
  }
  .footer__bottom {
    border-top: 1px solid #3a3a36;
    padding-block: 1.25rem;
    font-size: var(--fs-sm);
  }
  .footer__bottom p {
    margin: 0;
  }
  @media (max-width: 800px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
