---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../config/site';

interface Props {
  provider?: 'youtube' | 'bunny';
  /** ID YouTube, ou ID de vidéo Bunny Stream */
  id: string;
  title: string;
  poster: ImageMetadata;
  posterAlt?: string;
  /** Bibliothèque Bunny Stream (par défaut : celle de src/config/site.ts) */
  libraryId?: string;
  /** Image visible au chargement : pas de lazy loading */
  priority?: boolean;
  sizes?: string;
}

const {
  provider = 'youtube',
  id,
  title,
  poster,
  posterAlt = '',
  libraryId = site.bunnyLibraryId,
  priority = false,
  sizes = '(min-width: 1180px) 580px, (min-width: 900px) 50vw, 100vw',
} = Astro.props;

const vid = encodeURIComponent(id);
const embed =
  provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${vid}?autoplay=1&rel=0&modestbranding=1`
    : `https://iframe.mediadelivery.net/embed/${encodeURIComponent(libraryId)}/${vid}?autoplay=true&preload=true`;
// Sans JavaScript, le bouton reste un lien vers la vidéo
const fallback = provider === 'youtube' ? `https://www.youtube.com/watch?v=${vid}` : embed;
---

<video-facade class="facade" data-embed={embed} data-title={title}>
  <Picture
    src={poster}
    alt={posterAlt}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="facade__poster"
  />
  <a class="facade__play" href={fallback} rel="noopener">
    <span class="facade__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="28" height="28"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor"></path></svg>
    </span>
    <span class="visually-hidden">Lire la vidéo : {title}</span>
  </a>
</video-facade>

<script>
  class VideoFacade extends HTMLElement {
    connectedCallback() {
      this.querySelector('a')?.addEventListener('click', (event) => {
        event.preventDefault();
        const iframe = document.createElement('iframe');
        iframe.src = this.dataset.embed ?? '';
        iframe.title = this.dataset.title ?? 'Vidéo';
        iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
        iframe.allowFullscreen = true;
        iframe.referrerPolicy = 'strict-origin-when-cross-origin';
        this.replaceChildren(iframe);
        iframe.focus();
      }, { once: true });
    }
  }
  customElements.define('video-facade', VideoFacade);
</script>

<style>
  .facade {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--c-black);
    border-radius: var(--radius);
  }
  .facade :global(.facade__poster),
  .facade :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .facade__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--c-black);
    --focus: var(--c-yellow);
  }
  .facade__play:focus-visible {
    outline-offset: -6px;
  }
  .facade__icon {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    background: var(--c-yellow);
    border-radius: 50%;
    transition: transform 0.15s;
  }
  .facade__play:hover .facade__icon {
    transform: scale(1.08);
  }
</style>
