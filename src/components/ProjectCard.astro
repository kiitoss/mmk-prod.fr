---
import { Picture } from 'astro:assets';
import { typeLabels, type Projet } from '../lib/projets';

interface Props {
  projet: Projet;
  headingLevel?: 'h2' | 'h3';
}

const { projet, headingLevel: Tag = 'h3' } = Astro.props;
const { titre, client, lieu, date, type, vignette, vignetteAlt } = projet.data;
const href = `/realisations/${projet.id}`;
---

<article class="card">
  <Picture
    src={vignette}
    alt={vignetteAlt ?? ''}
    widths={[400, 600, 800]}
    sizes="(min-width: 1180px) 370px, (min-width: 700px) 33vw, 100vw"
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    class="card__img"
  />
  <div class="card__body">
    <p class="card__meta">{typeLabels[type]} · {date.getUTCFullYear()}</p>
    <Tag class="card__title"><a href={href}>{titre}</a></Tag>
    <p class="card__client">{client} — {lieu}</p>
    <span class="card__link" aria-hidden="true">Voir le projet →</span>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--c-white);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .card :global(.card__img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.25rem 1.4rem 1.5rem;
  }
  .card__meta {
    margin-bottom: 0.4rem;
    color: var(--c-text-3);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .card__title {
    margin-bottom: 0.4rem;
  }
  .card__title a {
    text-decoration: none;
  }
  /* Toute la carte est cliquable via le lien du titre */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__title a:focus-visible {
    outline: none;
  }
  .card:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }
  .card__client {
    color: var(--c-text-2);
  }
  .card__link {
    margin-top: auto;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--c-yellow);
    text-underline-offset: 0.3em;
  }
  .card:hover .card__link {
    text-decoration-color: currentColor;
  }
</style>
