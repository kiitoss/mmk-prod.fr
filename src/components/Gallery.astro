---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: ImageMetadata[];
  /** Préfixe des textes alternatifs */
  label: string;
}

const { images, label } = Astro.props;
---

<!--
  Lightbox sans JavaScript : chaque vignette ouvre un <dialog> natif via les
  attributs déclaratifs command / commandfor (Invoker Commands, HTML standard).
  Échap, clic hors de l'image (closedby="any") ou bouton « Fermer » referment la fenêtre.
-->
<ul class="gallery">
  {
    images.map((img, i) => (
      <li>
        <button type="button" class="gallery__thumb" command="show-modal" commandfor={`photo-${i + 1}`}>
          <Picture
            src={img}
            alt=""
            widths={[300, 450, 600]}
            sizes="(min-width: 1180px) 380px, (min-width: 640px) 50vw, 100vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            class="gallery__img"
          />
          <span class="visually-hidden">
            Agrandir la photo {i + 1} sur {images.length} — {label}
          </span>
        </button>
        <dialog id={`photo-${i + 1}`} class="lightbox" closedby="any" aria-label={`${label} — photo ${i + 1} sur ${images.length}`}>
          <Picture
            src={img}
            alt={`${label} — photo ${i + 1}`}
            widths={[800, 1200, 1600]}
            sizes="(min-width: 1280px) 1200px, 94vw"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="lazy"
            class="lightbox__img"
          />
          <button type="button" class="lightbox__close" command="close" commandfor={`photo-${i + 1}`}>
            Fermer
          </button>
        </dialog>
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gallery__thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: var(--c-black);
    overflow: hidden;
    cursor: zoom-in;
  }
  .gallery__thumb :global(.gallery__img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: opacity 0.15s;
  }
  .gallery__thumb:hover :global(.gallery__img) {
    opacity: 0.85;
  }

  .lightbox {
    max-width: min(1200px, 94vw);
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .lightbox::backdrop {
    background: rgb(29 29 27 / 0.92);
  }
  .lightbox :global(.lightbox__img) {
    width: auto;
    max-width: 100%;
    max-height: calc(94vh - 4rem);
    margin-inline: auto;
    border-radius: var(--radius);
  }
  .lightbox__close {
    display: block;
    min-height: 44px;
    margin: 0.75rem auto 0;
    padding: 0.5rem 1.25rem;
    background: var(--c-yellow);
    color: var(--c-black);
    border: 0;
    border-radius: var(--radius);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    --focus: var(--c-white);
  }
</style>
